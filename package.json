{
  "name": "rebobinate",
  "version": "0.2.1",
  "description": "Control the playback speed of any video with the keyboard.",
  "keywords": [
    "video",
    "playback-speed",
    "chrome-extension",
    "firefox-addon",
    "productivity",
    "accessibility"
  ],
  "author": "shbernal",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:chrome": "tsc -b && vite build && node scripts/open-chromium.mjs",
    "dev:firefox": "pnpm run build:firefox && node scripts/open-gecko.mjs firefox",
    "dev:zen": "pnpm run build:firefox && node scripts/open-gecko.mjs zen",
    "inspect:chrome": "node scripts/inspect-chromium.mjs",
    "check:filters": "node scripts/check-filters.mjs",
    "blockers:fetch": "node scripts/fetch-blockers.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "build": "tsc -b && vite build",
    "build:firefox": "EXT_TARGET=firefox pnpm run build",
    "package:firefox": "pnpm run build:firefox && web-ext build --source-dir dist-firefox --artifacts-dir release --filename rebobinate-firefox-{version}.zip --overwrite-dest",
    "package:source": "node scripts/package-source.mjs",
    "publish:amo": "node scripts/publish-amo.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "knip": "knip",
    "lint:firefox": "pnpm run build:firefox && web-ext lint --source-dir dist-firefox",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "tsc -b && vite build && playwright test",
    "e2e:headed": "tsc -b && vite build && playwright test --headed",
    "e2e:ui": "tsc -b && vite build && playwright test --ui",
    "format": "oxfmt --check .",
    "format:write": "oxfmt ."
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.0",
    "knip": "^6.45.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "web-ext": "^10.8.0"
  }
}
