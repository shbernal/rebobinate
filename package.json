{
  "name": "rebobinate",
  "version": "0.2.0",
  "description": "Control the playback speed of any video with the keyboard.",
  "keywords": [
    "video",
    "playback-speed",
    "chrome-extension",
    "firefox-addon",
    "productivity",
    "accessibility"
  ],
  "author": "shbernal",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:chrome": "tsc -b && vite build && node scripts/open-chromium.mjs",
    "dev:firefox": "pnpm run build:firefox && node scripts/open-gecko.mjs firefox",
    "dev:zen": "pnpm run build:firefox && node scripts/open-gecko.mjs zen",
    "inspect:chrome": "node scripts/inspect-chromium.mjs",
    "check:filters": "node scripts/check-filters.mjs",
    "blockers:fetch": "node scripts/fetch-blockers.mjs",
    "build": "tsc -b && vite build",
    "build:firefox": "EXT_TARGET=firefox pnpm run build",
    "package:firefox": "pnpm run build:firefox && web-ext build --source-dir dist-firefox --artifacts-dir release --filename rebobinate-firefox-{version}.zip --overwrite-dest",
    "package:source": "node scripts/package-source.mjs",
    "publish:amo": "node scripts/publish-amo.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:firefox": "pnpm run build:firefox && web-ext lint --source-dir dist-firefox",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "tsc -b && vite build && playwright test",
    "e2e:headed": "tsc -b && vite build && playwright test --headed",
    "e2e:ui": "tsc -b && vite build && playwright test --ui",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "preview": "vite preview"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 80,
    "tabWidth": 2,
    "useTabs": false,
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "avoid",
    "endOfLine": "lf"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^30.1.1",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "web-ext": "^10.7.0"
  }
}
